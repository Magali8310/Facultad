        "def mse_ridge(w: np.ndarray, X: np.ndarray, y: np.ndarray, lam: float = 0.1) -> float:\n",
        "    y_pred = X @ w\n",
        "    return np.mean((y_pred - y) ** 2) + lam * np.sum(w[1:] ** 2)  # no regularizamos bias\n",
        "\n",
        "def grad_mse_ridge(w: np.ndarray, X: np.ndarray, y: np.ndarray, lam: float = 0.1) -> np.ndarray:\n",
        "    y_pred = X @ w\n",
        "    grad = (2 / len(y)) * X.T @ (y_pred - y)\n",
        "    grad[1:] += 2 * lam * w[1:]  # derivada de término L2 (no bias)\n",
        "    return grad\n"
      ],
