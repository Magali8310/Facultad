        "class RegresionLinealDG:\n",
        "    def __init__(self,\n",
        "                 loss_fn,\n",
        "                 grad_fn,\n",
        "                 hyperparams=None):\n",
        "        hyperparams = hyperparams or {}\n",
        "        self.loss_fn = loss_fn\n",
        "        self.grad_fn = grad_fn\n",
        "        self.alpha = hyperparams.get(\"alpha\", 0.01)\n",
        "        self.num_iterations = hyperparams.get(\"num_iterations\", 1000)\n",
        "        self.tol = hyperparams.get(\"tol\", 1e-4)\n",
        "        self.batch_size = hyperparams.get(\"batch_size\", None)  # None → batch completo\n",
        "        self.w = None\n",
        "\n",
        "    def fit(self, X, y):\n",
        "        # agrego columna para el intercept\n",
        "        col_ones = np.ones((X.shape[0], 1))\n",
        "        X_train_ext = np.hstack((col_ones, X))\n",
        "        n_samples, n_features = X_train_ext.shape\n",
        "\n",
        "        # inicializo pesos\n",
        "        self.w = np.zeros(n_features)\n",
        "        alpha = self.alpha\n",
        "        num_iterations = self.num_iterations\n",
        "        tol = self.tol\n",
        "        batch_size = self.batch_size or n_samples\n",
        "\n",
        "        prev_loss = float(\"inf\")\n",
        "\n",
        "        for it in range(num_iterations):\n",
        "            # selecciono batch aleatorio\n",
        "            if batch_size >= n_samples:\n",
        "                X_batch = X_train_ext\n",
        "                y_batch = y\n",
        "            else:\n",
        "                idx = np.random.choice(n_samples, batch_size, replace=False)\n",
        "                X_batch = X_train_ext[idx]\n",
        "                y_batch = y[idx]\n",
        "\n",
        "            # calculo gradiente y actualizo pesos\n",
        "            grad = self.grad_fn(self.w, X_batch, y_batch)\n",
        "            self.w -= alpha * grad\n",
        "\n",
        "            # chequeo criterio de parada\n",
        "            loss = self.loss_fn(self.w, X_train_ext, y)\n",
        "            if abs(prev_loss - loss) < tol:\n",
        "                break\n",
        "            prev_loss = loss\n",
        "\n",
        "    def predict(self, X):\n",
        "        X_ext = np.hstack((np.ones((X.shape[0], 1)), X))\n",
        "        return X_ext @ self.w\n"
      ],
