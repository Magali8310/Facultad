      "outputs": [],
      "source": [
        "hyperparametros = {\"alpha\": 0.01, \"num_iterations\": 1000, \"tol\": 0.01}\n",
        "\n",
        "reg = RegresionLinealDG(mse, grad_mse, hyperparametros)"
      ]
    },
